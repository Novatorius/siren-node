{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "siren.app.json",
  "description": "One Siren app and its features, which siren apps apply declares.",
  "type": "object",
  "required": [
    "version",
    "apps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "org": {
      "type": "string",
      "minLength": 1,
      "description": "The slug of the organization the app belongs to, for a person in several. --org and SIREN_ORG win over it."
    },
    "name": {
      "type": "string",
      "description": "A recipe's name. The tool sends only the app's own name."
    },
    "description": {
      "type": "string"
    },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 64,
        "not": {
          "enum": [
            "requests",
            "events",
            "scopes",
            "kinds"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name the dashboard shows."
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Where Siren sends requests: https, or http to localhost. ${SIREN_APP_URL} is filled from the shell or .env."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "examples": [
                "event:sale",
                "event:refund",
                "event:site-visited",
                "ledger:conversions:read",
                "ledger:transactions:read",
                "ledger:obligations:read",
                "ledger:payouts:read",
                "ledger:engagements:read",
                "ledger:opportunities:read",
                "ledger:fulfillments:read",
                "records:products:read",
                "records:products:manage",
                "records:coupons:read",
                "records:coupons:manage",
                "records:collaborators:read",
                "records:collaborators:manage",
                "records:collaborator-groups:read",
                "records:collaborator-groups:manage",
                "records:programs:read",
                "records:programs:manage",
                "records:program-groups:read",
                "records:program-groups:manage",
                "records:distributors:read",
                "records:distributors:manage",
                "records:application-forms:read",
                "records:application-forms:manage",
                "records:applications:read",
                "records:applications:manage",
                "records:notification-rules:read",
                "records:notification-rules:manage",
                "records:properties:read"
              ]
            },
            "description": "The app key's scopes. siren apps scopes lists the ones your Siren issues, custom event types included."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "examples": [
                "allocation.completed",
                "collaborator.applied",
                "collaborator.created",
                "collaborator.deactivated",
                "collaborator.declined",
                "collaborator.deleted",
                "collaborator_group.created",
                "collaborator_group.deleted",
                "collaborator_group.member_added",
                "collaborator_group.member_removed",
                "collaborator_group.updated",
                "collaborator.joined",
                "collaborator.registered",
                "collaborator.updated",
                "conversion.approved",
                "conversion.created",
                "conversion.rejected",
                "conversion.renewed",
                "coupon.applied",
                "coupon.linked",
                "coupon.merged",
                "coupon.unlinked",
                "credit.issued",
                "credit.redeemed",
                "currency.created",
                "currency.deleted",
                "distribution.completed",
                "distributor.created",
                "distributor.deleted",
                "distributor.updated",
                "engagement.awarded",
                "engagement.completed",
                "engagement.created",
                "fulfillment.created",
                "fulfillment.updated",
                "lead.created",
                "metrics.updated",
                "obligation.approved",
                "obligation.completed",
                "obligation.created",
                "obligation.rejected",
                "obligation.superseded",
                "opportunity.created",
                "opportunity.invalidated",
                "payout.created",
                "payout.failed",
                "payout.paid",
                "payout.waiting",
                "product.merged",
                "program.created",
                "program.deleted",
                "program_group.created",
                "program_group.deleted",
                "program_group.updated",
                "program.status_changed",
                "program.updated",
                "refund.created",
                "refund.recorded",
                "renewal.created",
                "sale.created",
                "store.connected",
                "store.disconnected",
                "transaction.completed",
                "transaction.created"
              ]
            },
            "description": "The events Siren tells the app about. siren apps events lists them."
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Email addresses Siren tells when something is wrong with the app."
          },
          "features": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "maxProperties": 50,
            "additionalProperties": {
              "type": "object",
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "postConversionAction",
                    "postAllocationAction",
                    "payoutMethod",
                    "distributionResolver",
                    "customEvent",
                    "metricCalculation",
                    "metricFilter",
                    "incentiveResolver",
                    "transactionFilter",
                    "incentiveType",
                    "engagementCalculation",
                    "engagementFilter",
                    "programGroupSorter",
                    "collaboratorGroupStructure"
                  ],
                  "description": "The feature's kind, which locks once Siren makes it: Post-conversion action (postConversionAction), Post-allocation action (postAllocationAction), Payout method (payoutMethod), Distribution resolver (distributionResolver), Custom event (customEvent), Metric calculation (metricCalculation), Customer filter for distributors (metricFilter), Attribution model (incentiveResolver), Transaction filter (transactionFilter), Incentive structure (incentiveType), Engagement calculation (engagementCalculation), Customer filter for programs (engagementFilter), Program group structure (programGroupSorter), Collaborator group structure (collaboratorGroupStructure)."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The name the dashboard shows."
                },
                "description": {
                  "type": "string"
                },
                "currencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "description": "For a Payout method (payoutMethod): the currency codes it pays."
                },
                "answerWindowMinutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 43200,
                  "description": "How long Siren waits for an answer to an ask, in minutes."
                },
                "scoresMoney": {
                  "type": "boolean",
                  "description": "For a Metric calculation (metricCalculation): whether its score is an amount of money."
                },
                "conversionTypes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "sale",
                      "lead",
                      "renewal"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "For an Incentive structure (incentiveType): the conversions it pays, each once."
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean"
                      }
                    }
                  },
                  "description": "For a Custom event (customEvent): each field's name to {\"type\": ..., \"required\": ...}."
                },
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 20,
                  "description": "For a Custom event (customEvent): the websites that may send it from a browser, such as example.com or *.example.com."
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "payoutMethod"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "currencies"
                    ]
                  },
                  "else": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "currencies"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "incentiveType"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "conversionTypes"
                    ]
                  },
                  "else": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "conversionTypes"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "metricCalculation"
                      }
                    }
                  },
                  "else": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "scoresMoney"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "customEvent"
                      }
                    }
                  },
                  "else": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "fields"
                          ]
                        },
                        {
                          "required": [
                            "domains"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "description": "Each feature under its feature key."
          }
        },
        "if": {
          "required": [
            "features"
          ],
          "properties": {
            "features": {
              "not": {
                "additionalProperties": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "customEvent"
                    }
                  }
                }
              }
            }
          }
        },
        "then": {
          "required": [
            "url"
          ]
        }
      },
      "description": "One app under its app key. A Siren recipe maps each key to its record, so apps is a map. It holds one app, since the env file beside siren.app.json keeps that one app's key."
    }
  }
}
