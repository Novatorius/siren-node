{
  "name": "@novatorius/siren",
  "version": "0.3.0",
  "description": "Official Siren SDK for Node.js and TypeScript \u2014 affiliate and incentive tracking for any commerce stack.",
  "keywords": [
    "siren",
    "affiliate",
    "affiliate-marketing",
    "referral",
    "referral-program",
    "incentives",
    "rewards",
    "sdk",
    "typescript",
    "nodejs",
    "webhooks",
    "ecommerce",
    "stripe"
  ],
  "homepage": "https://sirenaffiliates.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novatorius/siren-node.git"
  },
  "bugs": {
    "url": "https://github.com/Novatorius/siren-node/issues"
  },
  "author": "Novatorius",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.3"
  },
  "bin": {
    "siren": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./storefront": {
      "import": {
        "types": "./dist/storefront.d.ts",
        "default": "./dist/storefront.js"
      },
      "require": {
        "types": "./dist/storefront.d.cts",
        "default": "./dist/storefront.cjs"
      }
    },
    "./connect": {
      "import": {
        "types": "./dist/connect.d.ts",
        "default": "./dist/connect.js"
      },
      "require": {
        "types": "./dist/connect.d.cts",
        "default": "./dist/connect.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "openapi.yaml",
    "scripts/prepare.mjs",
    "siren.app.schema.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "typesVersions": {
    "*": {
      "storefront": [
        "./dist/storefront.d.ts"
      ],
      "connect": [
        "./dist/connect.d.ts"
      ]
    }
  }
}
